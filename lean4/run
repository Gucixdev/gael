#!/usr/bin/env bash
# lean4/run - build the proofs, audit their axioms, scan the sources for escape hatches; exit 0 when all pass. The
# steps are in ../../holyc/lean4/lib.sh; a differential test against the C code adds diff_test and mutant lines (see
# core/lean4/run).
. "$(dirname "$0")/../../holyc/lean4/lib.sh" || exit 2
lean_build
lean_audit
lean_scan
# the gem against the Lean model: the check bytes of 203 words, from `lean --run` and from gael itself
if [[ -x ../gael ]]; then
    if diff <(LEAN_PATH=.lake/build/lib/lean lean --run Gael/SecdedOracle.lean) <(../gael oracle.gael) > /dev/null; then
        step ok "memlib/bitspace: gem check bytes = Lean oracle on 203 words"
    else step FAIL "memlib/bitspace differs from the Lean oracle"; fi
else step FAIL "build ../gael first (./build)"; fi
lean_end
