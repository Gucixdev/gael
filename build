#!/usr/bin/env bash
# build - compile gael: one translation unit, C89, warnings as errors. It links the C library dynamically, because
# gpu-each loads wgpu-native at run time with dlopen, which a static glibc or musl cannot do; GAEL_STATIC=1 links
# statically instead, and then every gpu-each runs on the VM. CC picks the compiler (default cc); CFLAGS adds flags.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
flags=(-std=c89 -pedantic -Wall -Wextra -Werror -O2)
if [ "${GAEL_STATIC:-}" = 1 ]; then
	${CC:-cc} "${flags[@]}" ${CFLAGS:-} -static -o gael src/main.c -lm -ldl
else
	${CC:-cc} "${flags[@]}" ${CFLAGS:-} -o gael src/main.c -lm -ldl
fi
