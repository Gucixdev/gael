(defmacro swap ((_ a b) (let ((tmp a)) (set a b) (set b tmp))))
(defmacro bad-dup ((_ a a) a))
(defmacro bad-res ((_ if) 1))
(defmacro bad-dots ((_ ... a) a))
(defmacro bad-two ((_ a ... b ...) a))
(defmacro bad-depth ((_ a ...) a))
(defmacro bad-rep ((_ a) (a ...)))
(defmacro bad-const ((_ a) (println "x" ...)))
(defmacro no-rules)
(defmacro bad-rule ((_ a)))
(defmacro println ((_ a) a))
(defn swap ((x : int)) : int x)
(defmacro pair ((_ (a ...) (b ...)) (do (println "%d %d" a b) ...)))
(swap 1)
(pair (1 2) (3))
(let ((x 1)) (defmacro inner ((_) 1)) x)
(defmacro swap ((_ a) a))
