; what a GPU does not run, in gpu-each: each message says what to write instead
(struct P (x : f32) (y : float) (on : bool) (n : i32) (name : string ""))
(def ps : (vec P) (vec))
(def total : f32 0.0)
(def count 0)
(defn helper ((a : f32)) : f32 (* a 2.0))
(gpu-each (p ps) (set p.y 1.0))
(gpu-each (p ps) (when p.on (set p.x 0.0)))
(gpu-each (p ps) (set total (+ total p.x)))
(gpu-each (p ps) (set p.x (helper p.x)))
(gpu-each (p ps) (println "%f" p.x))
(gpu-each (p ps) (let ((k 2)) (set p.n (* p.n k))))
(gpu-each (p ps) (set p.n (+ p.n count)))
(gpu-each (p ps) (for (i 0 3) (set p.x (+ p.x 1.0))))
(gpu-each (p ps) (gpu-each (q ps) (set q.x 0.0)))
(gpu-each (p ps) (set p.x (f32 (float p.n))))
(gpu-each (p ps) (set p.name "x"))
(gpu-each (p ps i) (set i 3))
(gpu-each (p 5) (set p.x 0.0))
(gpu-each p (set p.x 0.0))
