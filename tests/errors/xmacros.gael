(defmacro m1 ((_) (name-of)))
(m1)
(defmacro m2 ((_ x) (name-of (f x))))
(m2 1)
(defmacro m3 ((_) (name-of "a b")))
(m3)
(defmacro m4 ((_) (name-of "1" 2)))
(m4)
(defmacro m5 ((_) (string-of)))
(m5)
(defmacro m6 ((_) (name-of 1.5)))
(m6)
(defmacro m7 ((_ v) (let (((name-of v "2") 1)) x2)))   ; x2 is the use's name, not the template's
(m7 x)
(defn string-of () 1)
(let ((n (name-of "s" "-q"))) n)
