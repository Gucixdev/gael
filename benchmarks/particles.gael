; a game loop: particles in a vec of structs move and bounce off the walls of a 1000 x 1000 box, frame after frame
(struct Particle (x : float) (y : float) (vx : float) (vy : float))

(def seed 1)
(defn rand () : int                            ; Park-Miller, the same numbers in every language
  (set seed (% (* seed 16807) 2147483647))
  seed)

(let ((ps : (vec Particle) (vec)) (sum 0.0))
  (for (i 0 10000)
    (let ((x (float (% (rand) 1000))) (y (float (% (rand) 1000)))
          (vx (float (- (% (rand) 21) 10))) (vy (float (- (% (rand) 21) 10))))
      (push ps (Particle x y vx vy))))
  (for (frame 0 600)
    (for (i 0 (len ps))
      (let ((p (get ps i)))
        (set p.x (+ p.x (* p.vx 0.5)))
        (set p.y (+ p.y (* p.vy 0.5)))
        (when (or (< p.x 0.0) (> p.x 1000.0)) (set p.vx (- 0.0 p.vx)))
        (when (or (< p.y 0.0) (> p.y 1000.0)) (set p.vy (- 0.0 p.vy)))
        (put ps i p))))
  (for (p ps) (set sum (+ sum p.x p.y)))
  (println "%d" (int sum)))
