; gpu-each over a million balls, 20 steps: on the GPU through wgpu when GAEL_WGPU finds it, else the loop on the VM
(struct Ball (x : f32) (y : f32) (vx : f32) (vy : f32))
(def balls : (vec Ball) (vec))
(for (k 0 1000000) (push balls (Ball (f32 (float (% k 1000))) 10.0 0.5 0.0)))
(def dt : f32 0.01)
(def gravity : f32 -9.8)
(for (_ 0 20)
  (gpu-each (b balls)
    (set b.vy (+ b.vy (* gravity dt)))
    (set b.x (+ b.x (* b.vx dt)))
    (set b.y (+ b.y (* b.vy dt)))
    (when (< b.y 0.0) (set b.y (- b.y)) (set b.vy (* (- b.vy) 0.9)))))
(println "%v" (get balls 999999))
