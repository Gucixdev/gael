; a hash map with int keys, as an entity table: a million inserts, then a million lookups, some of them misses
(let ((m : (map int int) (map)) (sum 0))
  (for (i 0 1000000) (insert m (% (* i 7919) 1000003) i))
  (for (i 0 1000000)
    (match (lookup m i)
      ((some v) (set sum (+ sum v)))
      (none (set sum (- sum 1)))))
  (println "%d %d" (len m) sum))
