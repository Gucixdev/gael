; a particle is #(x y vx vy)
(define seed 1)
(define (rand)
  (set! seed (modulo (* seed 16807) 2147483647))
  seed)

(define (main)
  (let ((ps (make-vector 10000 #f)))
    (do ((i 0 (+ i 1))) ((= i 10000))
      (let* ((x (exact->inexact (modulo (rand) 1000)))
             (y (exact->inexact (modulo (rand) 1000)))
             (vx (exact->inexact (- (modulo (rand) 21) 10)))
             (vy (exact->inexact (- (modulo (rand) 21) 10))))
        (vector-set! ps i (vector x y vx vy))))
    (do ((frame 0 (+ frame 1))) ((= frame 600))
      (do ((i 0 (+ i 1))) ((= i 10000))
        (let* ((p (vector-ref ps i))
               (x (+ (vector-ref p 0) (* (vector-ref p 2) 0.5)))
               (y (+ (vector-ref p 1) (* (vector-ref p 3) 0.5))))
          (vector-set! p 0 x)
          (vector-set! p 1 y)
          (when (or (< x 0.0) (> x 1000.0)) (vector-set! p 2 (- 0.0 (vector-ref p 2))))
          (when (or (< y 0.0) (> y 1000.0)) (vector-set! p 3 (- 0.0 (vector-ref p 3)))))))
    (let loop ((i 0) (sum 0.0))
      (if (= i 10000)
          (begin (display (inexact->exact (truncate sum))) (newline))
          (let ((p (vector-ref ps i)))
            (loop (+ i 1) (+ sum (+ (vector-ref p 0) (vector-ref p 1)))))))))

(main)
