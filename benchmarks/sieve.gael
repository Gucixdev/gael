; a vec of bools: the primes below n, by the sieve of Eratosthenes
(defn sieve ((n : int)) : int
  (let ((flags : (vec bool) (vec)) (count 0))
    (for (i 0 n) (push flags true))
    (for (i 2 n)
      (when (get flags i)
        (set count (+ count 1))
        (let ((k (* i i)))
          (while (< k n)
            (put flags k false)
            (set k (+ k i))))))
    count))

(println "%d" (sieve 5000000))
