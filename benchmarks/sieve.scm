(define (sieve n)
  (let ((flags (make-vector n #t)))
    (let loop ((i 2) (count 0))
      (cond ((= i n) count)
            ((vector-ref flags i)
             (let mark ((k (* i i)))
               (when (< k n)
                 (vector-set! flags k #f)
                 (mark (+ k i))))
             (loop (+ i 1) (+ count 1)))
            (else (loop (+ i 1) count))))))

(display (sieve 5000000))
(newline)
