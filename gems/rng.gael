(gem rng :version "0.1.0")
; PCG32 (O'Neill 2014, the XSH-RR output), ported from holyc's rng.h: a 64-bit state and an odd increment, which
; picks one of 2^63 streams; good statistics (it passes BigCrush) from 16 bytes. The same seed and stream give the
; same numbers on every machine.
;
;   (def dice (Rng.seed 42 0))    ; seed and stream; a copy of it is the same generator, as with a vec
;   (dice.next)                   ; 0 to 2^32 - 1
;   (dice.float)                  ; [0, 1)
;   (dice.range 1 7)              ; [1, 7): a die
;   (dice.chance 0.25)            ; true one time in four

(struct Rng (s : (vec u64)))                     ; the state, then the increment

(defn Rng.next ((r : Rng)) : int
  (let ((old (get r.s 0)))
    (put r.s 0 (+ (* old 6364136223846793005) (get r.s 1)))
    (let ((xs (u32 (shr (bit-xor (shr old 18) old) 27))) (rot (u32 (shr old 59))))
      (int (bit-or (shr xs (int rot)) (shl xs (int (bit-and (- 0 rot) 31))))))))

(defn Rng.seed ((seed : int) (stream : int)) : Rng
  (let ((r (Rng (vec 0 (bit-or (shl (u64 stream) 1) 1)))))
    (r.next)
    (put r.s 0 (+ (get r.s 0) (u64 seed)))
    (r.next)
    r))

(defn Rng.float ((r : Rng)) : float (/ (float (r.next)) 4294967296.0))

(defn Rng.range ((r : Rng) (lo : int) (hi : int)) : int
  (assert (> hi lo) "Rng.range wants lo below hi")
  (+ lo (% (r.next) (- hi lo))))

(defn Rng.chance ((r : Rng) (p : float)) : bool (< (r.float) p))
