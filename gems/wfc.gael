(gem wfc :version "0.1.0" :requires (rng))
; Wave function collapse, the simple tiled model: a grid where each cell starts as every tile at once, and rules
; that say which tile may stand next to which. The cell with the fewest choices left is decided first - one tile,
; picked by weight - and what that rules out spreads to its neighbours, cell by cell, until every cell has one tile.
; A cell left with no tile is a contradiction, and the solve starts over. A cell's choices are the bits of one int,
; so there are at most 64 tiles.
;
;   (def w (Wfc.new width height tiles))  ; tiles 0 to tiles - 1, each weight 1.0, nothing allowed next to anything
;   (w.allow a dir b)                     ; b may stand at side dir of a (and a at the other side of b);
;                                         ; dir: wfc-up wfc-right wfc-down wfc-left
;   (w.allow-all a b)                     ; on every side
;   (w.weight tile 3.0)                   ; picked three times as often
;   (w.fix x y tile)                      ; this cell is decided before the solve: a border, an entrance
;   (w.solve r tries)                     ; with an Rng of the rng gem; true when it found a grid in that many tries
;   (w.tile x y)                          ; the tile of a cell once solved

(def wfc-up 0)
(def wfc-right 1)
(def wfc-down 2)
(def wfc-left 3)

(struct Wfc (w : int) (h : int) (n : int)
  (cells : (vec int))                             ; per cell: the tiles still possible, a bit each
  (compat : (vec int))                            ; per side and tile: the tiles allowed there, a bit each
  (weights : (vec float))
  (fixed : (vec int)))                            ; per cell: the tile decided before the solve, or -1

(defn Wfc.new ((w : int) (h : int) (n : int)) : Wfc
  (assert (and (> n 0) (<= n 64)) "Wfc.new takes 1 to 64 tiles")
  (let ((cells : (vec int) (vec)) (compat : (vec int) (vec)) (weights : (vec float) (vec)) (fixed : (vec int) (vec)))
    (for (_ 0 (* w h)) (push cells 0) (push fixed -1))
    (for (_ 0 (* 4 n)) (push compat 0))
    (for (_ 0 n) (push weights 1.0))
    (Wfc w h n cells compat weights fixed)))

(defn wfc--bit ((t : int)) : int (shl 1 t))
(defn wfc--all ((n : int)) : int (if (= n 64) -1 (- (shl 1 n) 1)))

(defn Wfc.allow ((w : Wfc) (a : int) (dir : int) (b : int)) : unit
  (let ((i (+ (* dir w.n) a)) (j (+ (* (% (+ dir 2) 4) w.n) b)))
    (put w.compat i (bit-or (get w.compat i) (wfc--bit b)))
    (put w.compat j (bit-or (get w.compat j) (wfc--bit a)))))

(defn Wfc.allow-all ((w : Wfc) (a : int) (b : int)) : unit
  (for (d 0 4) (w.allow a d b)))

(defn Wfc.weight ((w : Wfc) (t : int) (weight : float)) : unit (put w.weights t weight))

(defn Wfc.fix ((w : Wfc) (x : int) (y : int) (t : int)) : unit (put w.fixed (+ (* y w.w) x) t))

(defn Wfc.tile ((w : Wfc) (x : int) (y : int)) : int  ; the lowest tile left in the cell
  (let ((m (get w.cells (+ (* y w.w) x))) (t 0))
    (while (and (< t w.n) (= (bit-and m (wfc--bit t)) 0)) (set t (+ t 1)))
    t))

(defn wfc--count ((w : Wfc) (m : int)) : int
  (let ((k 0))
    (for (t 0 w.n) (when (!= (bit-and m (wfc--bit t)) 0) (set k (+ k 1))))
    k))

(defn wfc--around ((w : Wfc) (m : int) (dir : int)) : int ; what the tiles of m allow at their side dir
  (let ((u 0))
    (for (t 0 w.n) (when (!= (bit-and m (wfc--bit t)) 0) (set u (bit-or u (get w.compat (+ (* dir w.n) t))))))
    u))

(defn wfc--spread ((w : Wfc) (start : int)) : bool ; false at a contradiction
  (let ((stack : (vec int) (vec start)) (ok true))
    (while (and ok (> (len stack) 0))
      (let ((c (match (pop stack) ((some v) v) (none 0))))
        (let ((cx (% c w.w)) (cy (/ c w.w)) (m (get w.cells c)))
          (for (d 0 4)
            (let ((nx (+ cx (match d (1 1) (3 -1) (_ 0)))) (ny (+ cy (match d (0 -1) (2 1) (_ 0)))))
              (when (and ok (>= nx 0) (< nx w.w) (>= ny 0) (< ny w.h))
                (let ((nc (+ (* ny w.w) nx)))
                  (let ((old (get w.cells nc)))
                    (let ((now (bit-and old (wfc--around w m d))))
                      (when (!= now old)
                        (put w.cells nc now)
                        (if (= now 0) (set ok false) (push stack nc))))))))))))
    ok))

(defn wfc--pick ((w : Wfc) (r : Rng) (m : int)) : int ; a tile of m, by weight
  (let ((sum 0.0) (t 0) (at 0.0) (chosen -1))
    (for (k 0 w.n) (when (!= (bit-and m (wfc--bit k)) 0) (set sum (+ sum (get w.weights k)))))
    (set at (* (r.float) sum))
    (while (and (< t w.n) (< chosen 0))
      (when (!= (bit-and m (wfc--bit t)) 0)
        (set at (- at (get w.weights t)))
        (when (< at 0.0) (set chosen t)))
      (set t (+ t 1)))
    (if (< chosen 0) (- t 1) chosen)))

(defn wfc--run ((w : Wfc) (r : Rng)) : bool
  (let ((all (wfc--all w.n)) (ok true) (done false))
    (for (c 0 (* w.w w.h)) (put w.cells c all))
    (for (c 0 (* w.w w.h))                        ; first, out with every tile no tile allows beside it
      (when ok (set ok (wfc--spread w c))))
    (for (c 0 (* w.w w.h))
      (let ((f (get w.fixed c)))
        (when (and ok (>= f 0))
          (put w.cells c (bit-and (get w.cells c) (wfc--bit f)))
          (set ok (and (!= (get w.cells c) 0) (wfc--spread w c))))))
    (while (and ok (not done))
      (let ((best -1) (score 1000.0))             ; the undecided cell with the fewest choices, ties broken at random
        (for (c 0 (* w.w w.h))
          (let ((k (wfc--count w (get w.cells c))))
            (when (> k 1)
              (let ((s (+ (float k) (* 0.5 (r.float)))))
                (when (< s score) (set score s) (set best c))))))
        (if (< best 0)
          (set done true)
          (do (put w.cells best (wfc--bit (wfc--pick w r (get w.cells best))))
              (set ok (wfc--spread w best))))))
    ok))

(defn Wfc.solve ((w : Wfc) (r : Rng) (tries : int)) : bool
  (let ((ok false) (k 0))
    (while (and (not ok) (< k tries))
      (set ok (wfc--run w r))
      (set k (+ k 1)))
    ok))
