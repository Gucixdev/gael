(gem ecs :version "0.1.0")
; An entity component system the way flecs and the C ones go: an entity is a 64-bit id - its slot in the low 32 bits,
; the slot's generation above - so an id kept after its entity was despawned is told apart from the slot's next one.
; Each component is a column, a vec with one element per slot, so a query reads only the columns it names, one after
; the other in memory; a struct component's fields are columns of their own (gael lays vecs of structs out that way).
; Components and tags are bits of one 64-bit mask per slot: a query is one bit-and per entity, and a tag costs one bit.
;
;   (ecs-world Game
;     (components (pos : Vec2 (Vec2)) (hp : int 100))   ; name : type default-for-a-new-slot
;     (tags player burning))
;
; makes the entity type Game (one int), and for it:
;   (Game.spawn) (e.despawn) (e.alive?)               entities; Game.count, how many are alive
;   (e.pos) (e.set-pos v) (e.remove-pos)              each component: read, give (adds it), take off
;   Game-pos  Game-player                             the bit of each component and tag
;   (e.has? bits) (e.tag bits) (e.untag bits)         any bits: (e.has? (bit-or Game-pos Game-burning))
;   (Game.bit "burning")                              a bit by its name, for data and tools; 0 for no such name
;
; and (ecs-each Game (e pos hp) :with (player) :not (burning) body...) runs body for each entity that has pos, hp and
; the player tag but not burning, with e and a copy of each component named; the copies go back to their columns
; after body, so (set pos ...) changes the entity. Entities spawned in body are visited from the next query on.
; At most 64 components and tags in one world, and an entity's own functions check it is still alive.

(defmacro ecs-bits                                 ; each name its bit, counting up from k
  ((_ w k) (do))
  ((_ w k c more ...) (do (def (name-of w "-" c) (shl 1 k)) (ecs-bits w (+ k 1) more ...))))

(defmacro ecs-world
  ((_ w (components (c : ty d) ...) (tags t ...))
   (do
     (struct w (id : int))
     (def (name-of w "--mask") : (vec int) (vec))  ; per slot: the bits of what the entity there has
     (def (name-of w "--gen") : (vec int) (vec))   ; per slot: its generation, one up at each despawn
     (def (name-of w "--free") : (vec int) (vec))  ; slots to use again
     (def (name-of w "--" c) : (vec ty) (vec)) ...
     (ecs-bits w 0 c ... t ...)
     (def (name-of w "--names") : (map string int) (map ((string-of c) (name-of w "-" c)) ... ((string-of t) (name-of w "-" t)) ...))
     (defn (name-of w ".slot") ((e : w)) : int (bit-and e.id 0xffffffff))
     (defn (name-of w ".alive?") ((e : w)) : bool
       (let ((s (bit-and e.id 0xffffffff)))
         (and (< s (len (name-of w "--gen"))) (= (get (name-of w "--gen") s) (shr e.id 32)))))
     (defn (name-of w ".live") ((e : w)) : int     ; its slot, after checking it is alive
       (assert ((name-of w ".alive?") e) "this entity was despawned: its id is stale")
       (bit-and e.id 0xffffffff))
     (defn (name-of w ".spawn") () : w
       (match (pop (name-of w "--free"))
         ((some s) (w (bit-or (shl (get (name-of w "--gen") s) 32) s)))
         (none (let ((s (len (name-of w "--mask"))))
                 (push (name-of w "--mask") 0)
                 (push (name-of w "--gen") 0)
                 (push (name-of w "--" c) d) ...
                 (w s)))))
     (defn (name-of w ".despawn") ((e : w)) : unit
       (let ((s ((name-of w ".live") e)))
         (put (name-of w "--gen") s (+ (get (name-of w "--gen") s) 1))
         (put (name-of w "--mask") s 0)
         (push (name-of w "--free") s)))
     (defn (name-of w ".count") () : int (- (len (name-of w "--mask")) (len (name-of w "--free"))))
     (defn (name-of w ".has?") ((e : w) (bits : int)) : bool
       (= (bit-and (get (name-of w "--mask") ((name-of w ".live") e)) bits) bits))
     (defn (name-of w ".tag") ((e : w) (bits : int)) : unit
       (let ((s ((name-of w ".live") e)))
         (put (name-of w "--mask") s (bit-or (get (name-of w "--mask") s) bits))))
     (defn (name-of w ".untag") ((e : w) (bits : int)) : unit
       (let ((s ((name-of w ".live") e)))
         (put (name-of w "--mask") s (bit-and (get (name-of w "--mask") s) (bit-not bits)))))
     (defn (name-of w "." c) ((e : w)) : ty (get (name-of w "--" c) ((name-of w ".live") e))) ...
     (defn (name-of w ".set-" c) ((e : w) (v : ty)) : unit
       (let ((s ((name-of w ".live") e)))
         (put (name-of w "--" c) s v)
         (put (name-of w "--mask") s (bit-or (get (name-of w "--mask") s) (name-of w "-" c))))) ...
     (defn (name-of w ".remove-" c) ((e : w)) : unit
       (let ((s ((name-of w ".live") e)))
         (put (name-of w "--mask") s (bit-and (get (name-of w "--mask") s) (bit-not (name-of w "-" c)))))) ...
     (defn (name-of w ".bit") ((name : string)) : int
       (match (lookup (name-of w "--names") name) ((some b) b) (none 0))))))

(defmacro ecs-each
  ((_ w (e c ...) :with (h ...) :not (n ...) body ...)
   (let ((want (bit-or 0 0 (name-of w "-" c) ... (name-of w "-" h) ...))
         (skip (bit-or 0 0 (name-of w "-" n) ...)))
     (for (s 0 (len (name-of w "--mask")))
       (let ((m (get (name-of w "--mask") s)))
         (when (and (= (bit-and m want) want) (= (bit-and m skip) 0))
           (let ((e (w (bit-or (shl (get (name-of w "--gen") s) 32) s)))
                 (c (get (name-of w "--" c) s)) ...)
             body ...
             (put (name-of w "--" c) s c) ...))))))
  ((_ w (e c ...) :with (h ...) body ...) (ecs-each w (e c ...) :with (h ...) :not () body ...))
  ((_ w (e c ...) :not (n ...) body ...) (ecs-each w (e c ...) :with () :not (n ...) body ...))
  ((_ w (e c ...) body ...) (ecs-each w (e c ...) :with () :not () body ...)))
