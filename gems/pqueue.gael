(gem pqueue :version "0.1.0")
; A priority queue: a binary heap in one vec, ported from holyc's priority_queue.h. An item is an id - what it
; stands for is yours: a slot, an index into a vec of jobs, an entity - and a priority: 1 comes out first, 2 after
; it, and so on; 0 or less is no priority at all, out after everything else, whatever numbers the others have. Items
; of one priority come out in the order they went in, so a run goes the same way every time.
;
;   (def jobs (PQ))               ; a queue; a copy of it is the same queue, as with a vec
;   (jobs.push 7 1)               ; id 7 at priority 1
;   (jobs.pop)                    ; (some item) with item.id and item.priority, none when empty
;   (jobs.peek)                   ; the same without taking it out
;   (len jobs) (jobs.clear)

(struct PQItem (id : int) (priority : int) (order : int))
(struct PQ (items : (vec PQItem) (vec)))

(def pq--order 0)                                ; counts the pushes of every queue: ties come out in this order

(defn pq--key ((p : int)) : int (if (<= p 0) 9223372036854775807 p))

(defn pq--before ((a : PQItem) (b : PQItem)) : bool
  (let ((ka (pq--key a.priority)) (kb (pq--key b.priority)))
    (or (< ka kb) (and (= ka kb) (< a.order b.order)))))

(defn pq--swap ((v : (vec PQItem)) (i : int) (j : int)) : unit
  (let ((x (get v i)))
    (put v i (get v j))
    (put v j x)))

(defn PQ.push ((q : PQ) (id : int) (priority : int)) : unit
  (push q.items (PQItem id priority pq--order))
  (set pq--order (+ pq--order 1))
  (let ((i (- (len q.items) 1)) (going true))
    (while (and going (> i 0))
      (let ((up (/ (- i 1) 2)))
        (if (pq--before (get q.items i) (get q.items up))
          (do (pq--swap q.items i up) (set i up))
          (set going false))))))

(defn PQ.pop ((q : PQ)) : (option PQItem)
  (let ((n (len q.items)))
    (if (= n 0)
      none
      (let ((top (get q.items 0)) (last (match (pop q.items) ((some x) x) (none (get q.items 0)))))
        (when (> n 1)
          (put q.items 0 last)
          (let ((i 0) (going true) (m (- n 1)))
            (while going
              (let ((l (+ (* 2 i) 1)) (r (+ (* 2 i) 2)) (best i))
                (when (and (< l m) (pq--before (get q.items l) (get q.items best))) (set best l))
                (when (and (< r m) (pq--before (get q.items r) (get q.items best))) (set best r))
                (if (= best i)
                  (set going false)
                  (do (pq--swap q.items i best) (set i best)))))))
        (some top)))))

(defn PQ.peek ((q : PQ)) : (option PQItem)
  (if (= (len q.items) 0) none (some (get q.items 0))))

(defn PQ.len ((q : PQ)) : int (len q.items))

(defn PQ.clear ((q : PQ)) : unit
  (while (> (len q.items) 0) (pop q.items)))
