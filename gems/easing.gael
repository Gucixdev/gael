(gem easing :version "0.1.0")
; Blends and easing curves, ported from holyc's easing.h. Each curve takes t from 0 to 1 and gives 0 at 0 and 1 at 1;
; scale the result to what moves: (lerp from to (ease-out-cubic t)).
;
;   (lerp a b t) (lerp-clamped a b t) (unlerp a b x)     ; a + (b - a) t; t kept in [0, 1]; the t that gives x
;   (step edge x) (smooth t) (smoothstep e0 e1 x)       ; 0 or 1; 3t^2 - 2t^3; smooth of x put in [0, 1] over e0..e1
;   (ease-in-quad t) (ease-out-quad t) (ease-in-out-quad t), and the same for cubic, sine and back

(defn easing--clamp01 ((t : float)) : float (if (< t 0.0) 0.0 (if (> t 1.0) 1.0 t)))

(defn lerp ((from : float) (to : float) (t : float)) : float (+ from (* (- to from) t)))
(defn lerp-clamped ((from : float) (to : float) (t : float)) : float (lerp from to (easing--clamp01 t)))
(defn unlerp ((from : float) (to : float) (x : float)) : float
  (if (= from to) 0.0 (/ (- x from) (- to from))))

(defn step ((edge : float) (x : float)) : float (if (< x edge) 0.0 1.0))
(defn smooth ((t : float)) : float (* t t (- 3.0 (* 2.0 t))))
(defn smoothstep ((e0 : float) (e1 : float) (x : float)) : float
  (smooth (easing--clamp01 (unlerp e0 e1 x))))

(defn ease-in-quad ((t : float)) : float (* t t))
(defn ease-out-quad ((t : float)) : float (* t (- 2.0 t)))
(defn ease-in-out-quad ((t : float)) : float
  (if (< t 0.5)
    (* 2.0 t t)
    (let ((u (+ (* -2.0 t) 2.0))) (- 1.0 (/ (* u u) 2.0)))))

(defn ease-in-cubic ((t : float)) : float (* t t t))
(defn ease-out-cubic ((t : float)) : float (let ((u (- 1.0 t))) (- 1.0 (* u u u))))
(defn ease-in-out-cubic ((t : float)) : float
  (if (< t 0.5)
    (* 4.0 t t t)
    (let ((u (+ (* -2.0 t) 2.0))) (- 1.0 (/ (* u u u) 2.0)))))

(defn ease-in-sine ((t : float)) : float (- 1.0 (cos (* t 1.5707963267948966))))
(defn ease-out-sine ((t : float)) : float (sin (* t 1.5707963267948966)))
(defn ease-in-out-sine ((t : float)) : float (/ (- (- (cos (* 3.141592653589793 t)) 1.0)) 2.0))

(defn ease-in-back ((t : float)) : float (- (* 2.70158 t t t) (* 1.70158 t t)))
(defn ease-out-back ((t : float)) : float
  (let ((u (- t 1.0))) (+ 1.0 (* 2.70158 u u u) (* 1.70158 u u))))
(defn ease-in-out-back ((t : float)) : float
  (let ((c2 (* 1.70158 1.525)))
    (if (< t 0.5)
      (let ((u (* 2.0 t))) (/ (* u u (- (* (+ c2 1.0) u) c2)) 2.0))
      (let ((u (- (* 2.0 t) 2.0))) (/ (+ (* u u (+ (* (+ c2 1.0) u) c2)) 2.0) 2.0)))))
