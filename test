#!/usr/bin/env bash
# test - build gael with every compiler here (C89, pedantic, warnings as errors) and once with AddressSanitizer and
# UndefinedBehaviorSanitizer, then run each build against:
#   examples/NAME.gael      stdout must equal examples/NAME.out, exit 0; NAME.in is its stdin, NAME.args its arguments
#   tests/errors/NAME.gael  every line of NAME.err must appear on stderr, exit 1; stdout must equal NAME.out if there is one
#   (for both, NAME.env holds VAR=value words for its environment, like a smaller heap)
#   tests/repl.in           the REPL's stdout must equal tests/repl.out, every line of tests/repl.err on stderr, and
#                           what it saved to repldump.gael (its header lines aside) must equal tests/repl.dump; then
#                           the REPL with a main.gael, and with a gem from gael's folder turned on and off
#   README.md               every "$ ./gael ARGS" example prints exactly the lines shown under it
#   docs/REFERENCE.md       its index has every built-in name gael -n lists
# Every run has GAEL_CHECK=1: freed memory is overwritten, so a stale read shows, and a program that ends normally
# must have freed every string, vec and map it made.
# Exit 0 when everything passed. Build outputs go to a temp folder; the checkout is not touched.
set -u
cd "$(dirname "${BASH_SOURCE[0]}")" || exit 1
export GAEL_CHECK=1

out=$(mktemp -d "${TMPDIR:-/tmp}/gael-test.XXXXXX") || exit 1
trap 'rm -rf -- "$out"' EXIT
export GAEL_HOME="$out/home" # gael's own folder: never the real ~/.gael
flags=(-std=c89 -pedantic -Wall -Wextra -Werror)
builds=()
pass=0 fail=0

for cc in gcc clang; do
	command -v "$cc" > /dev/null || continue
	if "$cc" "${flags[@]}" -O2 -o "$out/gael-$cc" src/main.c -lm 2> "$out/$cc.log"; then
		builds+=("$out/gael-$cc")
	else
		echo "FAIL build with $cc:"; sed 's/^/  /' "$out/$cc.log"; fail=$((fail + 1))
	fi
done
sanitized=0
for cc in gcc clang; do # the first compiler whose sanitizer runtime is installed
	command -v "$cc" > /dev/null || continue
	if "$cc" "${flags[@]}" -O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all \
		-o "$out/gael-asan" src/main.c -lm 2> "$out/asan.log"; then
		builds+=("$out/gael-asan")
		sanitized=1
		break
	fi
done
[ "$sanitized" = 1 ] || echo "skipped: no compiler here has its sanitizer runtime installed (libasan, libubsan)"

check() {	# check NAME OK: count a result, say what failed
	if [ "$2" = 1 ]; then pass=$((pass + 1)); else fail=$((fail + 1)); echo "FAIL $1"; fi
}

# README examples: a fenced line "$ ./gael ARGS" and the lines under it are a command and its whole output
readme=$(awk -v dir="$out" '
	/^```/ { if (n) close(file); n = 0; next }
	/^\$ \.\/gael ./ { k++; n = 1; file = dir "/readme-" k; print substr($0, 10) > (file ".args"); printf "" > file; next }
	n { print > file }
	END { print k + 0 }' README.md)

for bin in "${builds[@]}"; do
	b=${bin##*/}
	for f in examples/*.gael; do
		ok=1
		input=/dev/null
		[ -f "${f%.gael}.in" ] && input=${f%.gael}.in
		args=() envs=()
		[ -f "${f%.gael}.args" ] && read -r -a args < "${f%.gael}.args"
		[ -f "${f%.gael}.env" ] && read -r -a envs < "${f%.gael}.env"
		env TMPDIR="$out" "${envs[@]}" "$bin" "$f" "${args[@]}" < "$input" > "$out/stdout" 2> "$out/stderr" || ok=0
		cmp -s "$out/stdout" "${f%.gael}.out" || ok=0
		[ -s "$out/stderr" ] && ok=0
		check "$b $f" "$ok"
		[ "$ok" = 1 ] || { diff "${f%.gael}.out" "$out/stdout" | head -5; head -5 "$out/stderr"; }
	done
	for f in tests/errors/*.gael; do
		ok=1 envs=()
		[ -f "${f%.gael}.env" ] && read -r -a envs < "${f%.gael}.env"
		env "${envs[@]}" "$bin" "$f" > "$out/stdout" 2> "$out/stderr"
		[ $? = 1 ] || ok=0
		[ -f "${f%.gael}.out" ] && ! cmp -s "$out/stdout" "${f%.gael}.out" && { ok=0; echo "  stdout differs"; }
		while IFS= read -r line; do
			grep -qxF -- "$line" "$out/stderr" || { ok=0; echo "  missing: $line"; }
		done < "${f%.gael}.err"
		grep -q 'Sanitizer\|runtime error: .*\.c:' "$out/stderr" && ok=0
		check "$b $f" "$ok"
	done
	ok=1
	GAEL_HOME="$out/home-$b" "$bin" < tests/repl.in > "$out/stdout" 2> "$out/stderr" || ok=0
	cmp -s "$out/stdout" tests/repl.out || { ok=0; diff tests/repl.out "$out/stdout" | head -5; }
	grep -v '^; REPL session, ' "$out/home-$b/repldump.gael" | cmp -s - tests/repl.dump || { ok=0; echo "  repldump.gael differs"; }
	while IFS= read -r line; do
		grep -qxF -- "$line" "$out/stderr" || { ok=0; echo "  missing: $line"; }
	done < tests/repl.err
	grep -q 'Sanitizer' "$out/stderr" && ok=0
	check "$b repl" "$ok"
	mkdir -p "$out/home-main-$b" # the REPL runs main.gael from gael's folder first
	printf '(def greeting (format "hi %%s" "there"))\n' > "$out/home-main-$b/main.gael"
	ok=1
	printf 'greeting\n' | GAEL_HOME="$out/home-main-$b" "$bin" > "$out/stdout" 2>&1 || ok=0
	[ "$(cat "$out/stdout")" = '=> hi there : string' ] || { ok=0; head -3 "$out/stdout"; }
	check "$b repl with main.gael" "$ok"
	mkdir -p "$out/home-gems-$b/gems" # a gem from gael's folder, turned on and off while the REPL runs
	cp examples/gems/ecs-flat.gael "$out/home-gems-$b/gems/"
	ok=1
	printf '(enable ecs-flat)\n(ecs-name (ecs-spawn "x"))\n(disable ecs-flat)\n(ecs-name 0)\n(enable ecs-flat)\n(ecs-name 0)\n' |
		GAEL_HOME="$out/home-gems-$b" "$bin" > "$out/stdout" 2> "$out/stderr" || ok=0
	[ "$(cat "$out/stdout")" = $'=> x : string\n=> x : string' ] || { ok=0; head -3 "$out/stdout"; }
	grep -q 'ecs-name is in gem ecs-flat, which is off' "$out/stderr" || { ok=0; head -3 "$out/stderr"; }
	check "$b repl with gems" "$ok"
	for ((k = 1; k <= readme; k++)); do
		read -r -a args < "$out/readme-$k.args"
		"$bin" "${args[@]}" > "$out/stdout" 2>&1
		ok=1
		cmp -s "$out/stdout" "$out/readme-$k" || { ok=0; diff "$out/readme-$k" "$out/stdout" | head -5; }
		check "$b README: gael ${args[*]}" "$ok"
	done
done

if [ "${#builds[@]}" -gt 0 ]; then # docs/REFERENCE.md: every built-in name (gael -n) has its line in the index
	ok=1
	index=$(awk '/^## Index/ { on = 1; next } /^## / { on = 0 } on' docs/REFERENCE.md)
	while IFS= read -r name; do
		grep -qF -- "\`$name\`" <<< "$index" || { ok=0; echo "  not in the index of docs/REFERENCE.md: $name"; }
	done < <("${builds[0]}" -n)
	check "docs/REFERENCE.md has every built-in name" "$ok"
fi

echo "$pass passed, $fail failed (${#builds[@]} builds)"
[ "$fail" = 0 ]
