; gpu-each: the body runs once per element of a vec, on the GPU when gael finds one (wgpu-native, see GAEL_WGPU) and as
; a plain loop on the VM when not - with the same result. On the GPU the numbers are 32-bit: f32, i32, u32. Each run
; of the body writes only its own element, so they can all run at once.
(struct Ball (x : f32) (y : f32) (vx : f32) (vy : f32) (bounces : i32))

(def balls : (vec Ball) (vec))
(for (k 0 8) (push balls (Ball (f32 (float k)) (f32 (* 2.0 (float k))) 0.5 0.0 0)))

(def dt : f32 0.5)
(def gravity : f32 -2.0)

(defn step () : unit                            ; falls, and bounces back up off the floor at y = 0
  (gpu-each (b balls)
    (set b.vy (+ b.vy (* gravity dt)))
    (set b.x (+ b.x (* b.vx dt)))
    (set b.y (+ b.y (* b.vy dt)))
    (when (< b.y 0.0)
      (set b.y (- b.y))
      (set b.vy (- b.vy))
      (set b.bounces (+ b.bounces 1)))))

(for (_ 0 6) (step))
(for (b balls) (println "x %v y %v vy %v bounces %d" b.x b.y b.vy b.bounces))

(gpu-each (b balls i)                           ; i, the element's index, is a u32
  (let ((k : f32 (f32 i)))
    (set b.x (clamp (- b.x k) 0.0 2.0))))
(println "%v" (get balls 7))
