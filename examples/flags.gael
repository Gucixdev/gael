; Bools in a vec or a pool take one bit each: the elements are columns (SoA), and a column of bools is a run of bits,
; 64 to a cell - (vec bool), and the flags of structs kept in vecs and pools. Nothing changes in how they are used.

(struct Unit (name : string) (alive : bool) (hp : int) (visible : bool) (target : (option bool)))
(let ((flags : (vec bool) (vec)) (units : (vec Unit) (vec)) (n 0))
  (for (i 0 200) (push flags (= (% i 3) 0)))
  (put flags 1 true)
  (put flags 3 false)
  (for (f flags) (when f (set n (+ n 1))))
  (println "flags %d of %d, first %v %v %v %v" n (len flags) (get flags 0) (get flags 1) (get flags 2) (get flags 3))
  (match (pop flags) ((some f) (println "popped %b, %d left" f (len flags))) (none (println "none")))
  (for (i 0 130)
    (push units (Unit (format "u%d" i) (= (% i 2) 0) i (= (% i 5) 0) (if (= (% i 7) 0) (some true) none))))
  (let ((u (get units 70)))
    (set u.visible true)
    (set u.name (format "%s!" u.name))
    (put units 70 u))
  (let ((alive 0) (visible 0) (targets 0))
    (for (u units)
      (when u.alive (set alive (+ alive 1)))
      (when u.visible (set visible (+ visible 1)))
      (match u.target ((some t) (when t (set targets (+ targets 1)))) (none 0)))
    (println "alive %d visible %d targets %d" alive visible targets))
  (println "%v" (get units 70))
  (println "%v" (vec true false true)))
(let ((p : (pool Unit) (pool 100)) (hs : (vec (handle Unit)) (vec)))
  (for (i 0 100) (push hs (spawn p (Unit (format "p%d" i) (= (% i 3) 0) i true none))))
  (let ((h (get hs 42)) (u (get p (get hs 42))))
    (set u.alive true)
    (put p h u)
    (println "%v %b" (get p h) (get p (get hs 43)).alive)
    (remove p (get hs 10))
    (println "has %b %b" (has p (get hs 10)) (has p (get hs 11)))))
(let ((m (map ("a" true) ("b" false) ("c" true))))
  (println "%v" (values m)))
(def kept : (vec bool) (vec))
(arena
  (let ((v (vec true true false)))
    (push v true)
    (set kept (keep v))))
(println "kept %v" kept)

(struct W (on : bool) (a : bool) (label : string) (b : bool) (tags : (vec string)))
(let ((ws : (vec W) (vec)))
  (for (i 0 70) (push ws (W (= (% i 2) 0) true (format "w%d" i) false (vec (format "t%d" i)))))
  (put ws 5 (W true false (format "five") true (vec)))
  (let ((w (get ws 69))) (println "%v" w))
  (println "%v" (get ws 5))
  (let ((n 0)) (for (w ws) (when w.on (set n (+ n (len w.tags))))) (println "on tags %d" n))
  (arena
    (let ((v : (vec W) (vec)))
      (push v (W true true (format "x") true (vec (format "y"))))
      (push ws (keep (get v 0)))))
  (println "%v %d" (get ws 70) (len ws)))
(let ((p : (pool W) (pool 3)))
  (let ((h (spawn p (W false true (format "pw") true (vec (format "q"))))))
    (put p h (W true false (format "pw2") false (vec)))
    (println "%v" (get p h))))
