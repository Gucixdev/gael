; In if, when and while, and/or/not/nand/nor become jumps alone (the short circuit as code), no bool made and
; tested; everywhere else they make a bool. This checks that both give the same answer and call the same things in
; the same order, for every value of a, b and c.
(def log : (vec string) (vec))
(defn t ((s : string)) : bool (push log s) true)
(defn f ((s : string)) : bool (push log s) false)
(def bad 0)
(defmacro same
  ((_ name e) (let ((v e) (vlog (join log ""))) ; as a value first
                (set log (vec))
                (let ((c (if e true false)) (clog (join log "")))
                  (set log (vec))
                  (when (or (!= v c) (!= vlog clog))
                    (set bad (+ bad 1))
                    (println "%s: value %b %s, condition %b %s" name v vlog c clog))))))
(defn try-all ((a : bool) (b : bool) (c : bool))
  (same "and" (and (if a (t "a") (f "a")) (if b (t "b") (f "b"))))
  (same "or" (or (if a (t "a") (f "a")) (if b (t "b") (f "b"))))
  (same "not and" (not (and (if a (t "a") (f "a")) (if b (t "b") (f "b")))))
  (same "nand" (nand (if a (t "a") (f "a")) (if b (t "b") (f "b")) (if c (t "c") (f "c"))))
  (same "nor" (nor (if a (t "a") (f "a")) (if b (t "b") (f "b")) (if c (t "c") (f "c"))))
  (same "and or" (and (if a (t "a") (f "a")) (or (if b (t "b") (f "b")) (if c (t "c") (f "c")))))
  (same "or and" (or (and (if a (t "a") (f "a")) (if b (t "b") (f "b"))) (if c (t "c") (f "c"))))
  (same "not or not" (not (or (not (if a (t "a") (f "a"))) (and (if b (t "b") (f "b")) (not (if c (t "c") (f "c")))))))
  (same "nand in or" (or (nand (if a (t "a") (f "a")) (if b (t "b") (f "b"))) (nor (if c (t "c") (f "c")) (if a (t "a2") (f "a2")))))
  (same "and3" (and (if a (t "a") (f "a")) (if b (t "b") (f "b")) (if c (t "c") (f "c"))))
  (same "or3 not" (or (not (if a (t "a") (f "a"))) (not (if b (t "b") (f "b"))) (not (if c (t "c") (f "c")))))
  (same "not not" (not (not (and (if a (t "a") (f "a")) (or (if b (t "b") (f "b")) (not (if c (t "c") (f "c")))))))))
(for (i 0 8) (try-all (= (bit-and i 1) 1) (= (bit-and i 2) 2) (= (bit-and i 4) 4)))
(let ((n 0) (i 0))
  (while (and (< i 10) (or (= (% i 7) 0) (< n 100)) (not (= i 9)))
    (set n (+ n i))
    (set i (+ i 1)))
  (println "while: n %d i %d" n i))
(println "mismatches: %d" bad)
