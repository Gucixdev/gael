; strings made at run time: format checks its % codes like println, sh returns what a command printed
(defn plural ((n : int) (word : string)) : string
  (if (= n 1) (format "1 %s" word) (format "%d %ss" n word)))

(println "%s, %s" (plural 1 "file") (plural 3 "file"))

(def counted (sh "printf 'a\\nb\\nc\\n' | wc -l"))
(match (parse-int counted)
  ((some n) (println "wc counted %d lines" n))
  (none (println "wc printed %s" counted)))

(println "%v %v" (parse-float "2.5") (parse-int "seven"))
(println "true exits with %d, false with %d" (system "true") (system "false"))
(println "a color in hex: %x, -1 as an i32: %x" 0xff8800ff (i32 -1))
