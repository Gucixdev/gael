; int and float never mix silently: convert on purpose
(defn mean ((total : float) (count : int)) : float
  (/ total (float count)))

(def speed : float 4.5)
(println "mean %f, speed %f, as int %d" (mean 10.0 4) speed (int speed))
(println "%f %f %f" 2.0 (/ 1.0 3.0) (- 0.5))

; the C library's functions of floats; angles in radians
(def pi 3.141592653589793)
(defn length ((x : float) (y : float)) : float (sqrt (+ (* x x) (* y y))))
(println "length %f, angle %f, %f degrees" (length 3.0 4.0) (atan2 4.0 3.0) (* (/ (atan2 1.0 1.0) pi) 180.0))
(println "sin %f, cos %f, 2^10 %f, e %f, ln e %f" (sin (/ pi 2.0)) (cos 0.0) (pow 2.0 10.0) (exp 1.0) (ln (exp 1.0)))
(println "floor %f, ceil %f, as an int %d" (floor -2.5) (ceil -2.5) (int (floor 7.9)))
(let ((h : f32 2.0))                           ; on an f32 they give an f32
  (println "sqrt of an f32: %v" (sqrt h)))
(let ((nan (sqrt -1.0)))                       ; no error: nan, which is not even equal to itself
  (println "sqrt -1 = sqrt -1: %b" (= nan nan)))

; min, max, abs and clamp work on any numbers of one type; each value is worked out once
(def hp : u8 200)
(println "min %d, max %f, abs %d, clamp %f, hp at most 100: %d" (min 3 -1 2) (max 0.5 (- 2.0) 1.5) (abs -7)
         (clamp 1.25 0.0 1.0) (min hp 100))
(let ((best (max 2 9)) (max 3))               ; the names stay free: a variable named max hides the form
  (println "best %d, a local named max: %d" best max))
