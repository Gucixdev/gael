; return leaves the function at once; what its locals, matches and loops hold is let go on the way out.

(struct Item (name : string) (weight : float))

(defn heavy ((items : (vec Item)) (limit : float)) : (option string)
  (for (it items)
    (when (> it.weight limit)
      (return (some (format "%s is too heavy" it.name)))))
  none)

(defn key-of ((m : (map string int)) (want : int)) : string
  (for (k m)
    (match (lookup m k)
      ((some v) (when (= v want) (return k)))
      (none (return "?"))))
  "nobody")

(defn valid? ((hp : int)) : bool
  (let ((label (format "hp %d" hp)))
    (when (< hp 0) (return false))
    (if (> hp 100) (return false) true)))

(defn report ((n : int)) : unit
  (when (= n 0) (return))
  (println "report %d" n))

(def halve : (fn (int) int) (fn ((x : int)) : int (when (< x 0) (return 0)) (/ x 2)))

(println "%v" (heavy (vec (Item "rope" 1.0) (Item "anvil" 50.0)) 10.0))
(println "%v" (heavy (vec (Item "rope" 1.0)) 10.0))
(println "%s %s" (key-of (map ("a" 1) ("b" 2)) 2) (key-of (map ("a" 1)) 5))
(println "%b %b %b" (valid? -1) (valid? 50) (valid? 500))
(report 0)
(report 3)
(println "%d %d" (halve -5) (halve 9))
