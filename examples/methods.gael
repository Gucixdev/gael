; Methods and hooks. A function named Type.name belongs to a struct or an enum: (v.length) calls (Vec2.length v).
; Some names are hooks that forms call for values of the type, chosen when compiling: add sub mul div rem negate for
; + - * / % and (- x), equal for = and !=, compare for < <= > >=, text for %v and %s, len, get, put, for going
; through len and get, and init for (Type args...). A field can have a default: (hp : int 100).

(struct Vec2 (x : float 0.0) (y : float 0.0))  ; (Vec2) is (Vec2 0.0 0.0)

(defn Vec2.add ((a : Vec2) (b : Vec2)) : Vec2 (Vec2 (+ a.x b.x) (+ a.y b.y)))
(defn Vec2.sub ((a : Vec2) (b : Vec2)) : Vec2 (Vec2 (- a.x b.x) (- a.y b.y)))
(defn Vec2.mul ((a : Vec2) (k : float)) : Vec2 (Vec2 (* a.x k) (* a.y k)))
(defn Vec2.negate ((a : Vec2)) : Vec2 (Vec2 (- a.x) (- a.y)))
(defn Vec2.equal ((a : Vec2) (b : Vec2)) : bool (and (= a.x b.x) (= a.y b.y)))
(defn Vec2.text ((a : Vec2)) : string (format "<%f %f>" a.x a.y))
(defn Vec2.dot ((a : Vec2) (b : Vec2)) : float (+ (* a.x b.x) (* a.y b.y)))
(defn Vec2.length2 ((a : Vec2)) : float (a.dot a))

(enum Dir north east south west)
(defn Dir.turn ((d : Dir)) : Dir (match d (north Dir.east) (east Dir.south) (south Dir.west) (west Dir.north)))
(defn Dir.step ((d : Dir)) : Vec2
  (match d (north (Vec2 0.0 1.0)) (east (Vec2 1.0)) (south (Vec2 0.0 -1.0)) (west (Vec2 -1.0))))

(enum Team red blue)
(struct Player
  (name : string)
  (hp : int 100)
  (team : Team Team.blue)
  (pos : Vec2 (Vec2))
  (items : (vec string) (vec)))                ; each player gets its own vec

(defn Player.init ((name : string) (team : Team)) : Player
  (Player :name (format "%s the %v" name team) :team team)) ; inside Player's own functions (Player ...) is the struct
(defn Player.compare ((a : Player) (b : Player)) : int (- a.hp b.hp))
(defn Player.text ((p : Player)) : string (format "%s (%d hp) at %v" p.name p.hp p.pos))
(defn Player.hurt ((p : Player) (n : int)) : Player
  (set p.hp (- p.hp n))                        ; p is the function's own copy
  p)

(struct Ring (items : (vec int)) (start : int 0)) ; read from start on, wrapping around
(defn Ring.len ((r : Ring)) : int (len r.items))
(defn Ring.get ((r : Ring) (i : int)) : int (get r.items (% (+ r.start i) (len r.items))))
(defn Ring.put ((r : Ring) (i : int) (x : int)) (put r.items (% (+ r.start i) (len r.items)) x))

(let ((a (Vec2 1.0 2.0)) (b (Vec2 3.0 4.0)))
  (println "a + b = %v, a + b + a = %v" (+ a b) (+ a b a))
  (println "b - a = %s, -a = %v, a * 2 = %v" (- b a) (- a) (* a 2.0))
  (println "a = b: %b, a != b: %b, a = (Vec2 1.0 2.0): %b" (= a b) (!= a b) (= a (Vec2 1.0 2.0)))
  (println "a . b = %f, |b|^2 = %f" (a.dot b) (b.length2)))

(let ((d Dir.north) (pos (Vec2)))
  (for (_ 0 5)
    (set pos (+ pos (d.step)))
    (set d (d.turn)))                          ; a method gives a new value; set keeps it
  (println "walked to %v facing %v" pos d))

(let ((ann (Player "Ann" Team.red))
      (bob (Player :name "Bob" :hp 80)))       ; by name: no init, the defaults fill the rest
  (push ann.items "sword")
  (set bob (bob.hurt 30))
  (println "%v, items %v, team %v" ann ann.items ann.team)
  (println "%v, items %v, team %v" bob bob.items bob.team)
  (println "ann > bob: %b" (> ann bob)))

(let ((r (Ring (vec 1 2 3 4) 2))
      (v (vec 10 20)))
  (put r 0 30)                                 ; Ring.put: the item at start
  (for (x r) (print "%d " x))                  ; Ring.len and Ring.get
  (println "| len %d, first %d" (len r) (get r 0))
  (v.push 30)                                  ; a vec has no functions of its own: (push v 30)
  (println "%v has %d" v (v.len)))

(def by-length Vec2.length2)                   ; a type's function is a value like any other
(println "%f" (by-length (Vec2 3.0 4.0)))
(println "%f" ((Vec2 3.0 4.0).length2))        ; a method on an expression's value, in parens
