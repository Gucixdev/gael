; One namespace, as in Scheme: a function is a value of a type like (fn (int) int). It can be passed, kept in a
; variable, a vec or a struct field, and called from there; a local of the same name hides it. (fn (params) : type
; body...) makes one without a name; it cannot use the locals around it yet (no closures), only its parameters.
(struct Button (label : string) (on-click : (fn (int) string)))
(defn twice ((f : (fn (int) int)) (x : int)) : int (f (f x)))
(defn inc ((x : int)) : int (+ x 1))
(defn apply-all ((fs : (vec (fn (int) int))) (x : int)) : (vec int)
  (let ((out : (vec int) (vec)))
    (for (f fs) (push out (f x)))
    out))
(def op : (fn (int int) int) (fn ((a : int) (b : int)) : int (* a b)))
(let ((sq (fn ((n : int)) : int (* n n)))
      (b (Button "ok" (fn ((n : int)) : string (format "clicked %d" n))))
      (handlers (vec inc (fn ((n : int)) : int (- n 1)))))
  (println "%d %d %d" (twice inc 5) (twice sq 3) (op 6 7))
  (println "%v" (apply-all (vec inc sq) 10))
  (println "%s" (b.on-click 2))
  (println "%d %d" ((get handlers 0) 100) ((get handlers 1) 100))
  (println "%v %v" inc sq)
  (let ((inc 5))
    (println "a local shadows the function: %d" inc)))
