; An entity component system from the ecs gem that comes with gael (gems/ecs.gael next to the binary). Components
; are columns, tags are bits, and a query names what it needs: (ecs-each World (e c...) :with (tags) :not (tags) body).
(enable ecs)

(struct Vec2 (x : float 0.0) (y : float 0.0))
(defn Vec2.add ((a : Vec2) (b : Vec2)) : Vec2 (Vec2 (+ a.x b.x) (+ a.y b.y)))
(defn Vec2.mul ((a : Vec2) (k : float)) : Vec2 (Vec2 (* a.x k) (* a.y k)))

(ecs-world Game
  (components (pos : Vec2 (Vec2)) (vel : Vec2 (Vec2)) (hp : int 100) (name : string ""))
  (tags player enemy burning))

(defn spawn-enemy ((name : string) (x : float)) : Game
  (let ((e (Game.spawn)))
    (e.set-name name)
    (e.set-pos (Vec2 x 0.0))
    (e.set-vel (Vec2 -1.0 0.0))
    (e.set-hp 30)
    (e.tag Game-enemy)
    e))

(def hero (Game.spawn))
(hero.set-name "hero")
(hero.set-pos (Vec2))
(hero.tag Game-player)                          ; no vel: the move system leaves it be
(def goblin (spawn-enemy "goblin" 10.0))
(def imp (spawn-enemy "imp" 4.0))
(imp.tag Game-burning)

(defn move ((dt : float)) : unit                ; a system: every entity with a pos and a vel
  (ecs-each Game (_e pos vel) (set pos (+ pos (* vel dt)))))

(defn burn () : unit                            ; burning enemies lose 10 hp a tick
  (ecs-each Game (e hp name) :with (burning enemy)
    (set hp (- hp 10))
    (when (<= hp 0)
      (println "  %s burns up" name)
      (e.despawn))))

(for (tick 0 3)
  (move 1.0)
  (burn)
  (println "tick %d: %d alive" tick (Game.count))
  (ecs-each Game (_e pos hp name) :not (player)
    (println "  %s at %f with %d hp" name pos.x hp)))

(def ghost (Game.spawn))                        ; the imp's slot again, one generation on
(println "imp alive %b, ghost alive %b, goblin burning %b" (imp.alive?) (ghost.alive?) (goblin.has? Game-burning))
(goblin.tag (Game.bit "burning"))               ; a tag by its name, as data or a tool would give it
(burn)
(println "goblin hp %d, hero at %v" (goblin.hp) (hero.pos))
