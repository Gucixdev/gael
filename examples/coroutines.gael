; Coroutines: (async (f x)) runs f as a coroutine, which can wait - (sleep seconds), (yield) until the next step,
; (await co) for another coroutine's result - without the functions on the way knowing it. A game's loop runs them
; with (step-coroutines dt); a script or a server with (run-coroutines), which waits in real time.

(struct Guard (name : string) (x : float))
(def guards : (vec Guard) (vec (Guard "north" 0.0) (Guard "south" 10.0)))

(defn walk-to ((i : int) (x : float)) : unit       ; it waits, so the coroutine that calls it waits
  (let ((g (get guards i)))
    (println "  %s walks to %f" g.name x)
    (sleep 1.0)
    (put guards i (Guard g.name x))))

(defn patrol ((i : int) (rounds : int)) : string
  (let ((r 0) (route : (vec string) (vec)))
    (while (< r rounds)
      (walk-to i 5.0)
      (walk-to i 0.0)
      (push route (format "round %d" r))
      (set r (+ r 1)))
    (join route ", ")))

(defn countdown ((n : int)) : int                 ; one number a frame
  (when (> n 0)
    (println "  countdown %d" n)
    (yield)
    (countdown (- n 1)))
  n)

(defn report ((co : (coroutine string))) : string ; a coroutine can wait for another one
  (format "north is done: %s" (await co)))

(def north (async (patrol 0 1)))                  ; each runs at once, up to its first wait
(def south (async (patrol 1 2)))
(def cd (async (countdown 3)))
(def rep (async (report north)))

(let ((frame 0) (left 4))
  (while (> left 0)
    (println "frame %d, time %f" frame (coroutine-time))
    (arena (set left (step-coroutines 1.0)))      ; what the coroutines make is theirs, not the frame's
    (set frame (+ frame 1))))

(println "%s | %s | %d" (await rep) (await south) (await cd))
(println "done? %b %b" (done? north) (done? south))

(defn later ((secs : float) (word : string)) : string
  (sleep secs)
  (println "  %s" word)
  word)

(def last-one (async (later 0.02 "second")))      ; real time this time
(async (later 0.01 "first"))
(run-coroutines)
(println "%s, time >= 0.02: %b" (await last-one) (>= (coroutine-time) 0.02))
