; Coroutines: (coroutine (f x)) runs f as a coroutine, which can pause - (sleep seconds), (yield) until the next
; step - without the functions on the way knowing it. Nothing ever waits for one: (poll co) gives (some result) once
; it has ended and none before. A game's loop runs them with (step-coroutines dt); a script or a server with
; (run-coroutines), which goes on until none is left.

(struct Guard (name : string) (x : float))
(def guards : (vec Guard) (vec (Guard "north" 0.0) (Guard "south" 10.0)))

(defn walk-to ((i : int) (x : float)) : unit       ; it pauses, so the coroutine that calls it pauses
  (let ((g (get guards i)))
    (println "  %s walks to %f" g.name x)
    (sleep 1.0)
    (put guards i (Guard g.name x))))

(defn patrol ((i : int) (rounds : int)) : string
  (let ((r 0) (route : (vec string) (vec)))
    (while (< r rounds)
      (walk-to i 5.0)
      (walk-to i 0.0)
      (push route (format "round %d" r))
      (set r (+ r 1)))
    (join route ", ")))

(defn countdown ((n : int)) : int                 ; one number a frame
  (when (> n 0)
    (println "  countdown %d" n)
    (yield)
    (countdown (- n 1)))
  n)

(defn report ((co : (coroutine string))) : string ; one coroutine looks at another each step
  (while (not (done? co)) (yield))
  (match (poll co) ((some s) (format "north is done: %s" s)) (none "?")))

(def north (coroutine (patrol 0 1)))              ; each runs at once, up to its first pause
(def south (coroutine (patrol 1 2)))
(def cd (coroutine (countdown 3)))
(def rep (coroutine (report north)))

(let ((frame 0) (left 4))
  (while (> left 0)
    (println "frame %d, time %f, south %v" frame (coroutine-time) (poll south))
    (arena (set left (step-coroutines 1.0)))      ; what the coroutines make is theirs, not the frame's
    (set frame (+ frame 1))))

(println "%v | %v | %v" (poll rep) (poll south) (poll cd))
(println "done? %b %b" (done? north) (done? south))

(defn later ((secs : float) (word : string)) : string
  (sleep secs)
  (println "  %s" word)
  word)

(def last-one (coroutine (later 0.02 "second")))  ; real time this time
(coroutine (later 0.01 "first"))
(run-coroutines)
(println "%v, time >= 0.02: %b" (poll last-one) (>= (coroutine-time) 0.02))
