(gem ecs-flat :version "0.1.0" :provides (ecs))
; a tiny entity store: an entity is a number, its name sits in a vec

(def ecs-names : (vec string) (vec))

(defn ecs-spawn ((name : string)) : int
  (push ecs-names name)
  (- (len ecs-names) 1))

(defn ecs-name ((e : int)) : string (get ecs-names e))
